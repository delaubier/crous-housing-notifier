# ==========================================
# CROUS HOUSING NOTIFIER - CONFIGURATION
# ==========================================

# 1. CROUS Session Cookie (Optional but recommended)
# Leave empty for nationwide public stock.
# Or paste your PHPSESSID from Chrome DevTools to unlock student/DSE reserved rooms.
CROUS_PHPSESSID=

# 2. Geographic Bounding Box (lon1_lat1_lon2_lat2)
# Paris intra-muros (strictly Paris 75):
CROUS_BOUNDS=2.2240_48.9035_2.4450_48.8150
# (Alternative: leave empty to search nationwide)

# Strict Paris intra-muros filter (only 75001-75020 addresses, excludes suburbs)
ONLY_PARIS_INTRA_MUROS=true

# 3. Maximum Budget (in Euros, optional)
# e.g., 600 for max 600 € / month. Leave empty for no price filter.
MAX_PRICE_EUROS=

# 4. Monitoring Check Interval (in seconds)
# Recommended: 60 seconds or more to avoid overloading CROUS servers.
CHECK_INTERVAL_SECONDS=60

# ==========================================
# NOTIFICATION CHANNELS (Optional)
# ==========================================

# Discord Webhook URL (leave empty if not using Discord)
DISCORD_WEBHOOK_URL=

# Telegram Bot (leave empty if not using Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
